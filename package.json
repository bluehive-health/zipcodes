{
  "name": "@bluehive-health/zipcodes",
  "version": "9.0.0",
  "description": "Offline US ZIP code lookup for Node.js and TypeScript: city, state and coordinates for every ZIP, plus distance, radius search, reverse geocoding and city autocomplete. Zero dependencies, no API key.",
  "keywords": [
    "zip",
    "zipcode",
    "zipcodes",
    "zip code",
    "zip code lookup",
    "postal code",
    "usps",
    "us",
    "usa",
    "geo",
    "geocode",
    "reverse geocode",
    "latitude",
    "longitude",
    "distance",
    "radius",
    "haversine",
    "city",
    "state",
    "offline",
    "typescript"
  ],
  "homepage": "https://zipcodes.bluehive.com",
  "author": "BlueHive Health (https://github.com/bluehive-health)",
  "contributors": [
    "Dav Glass <davglass@gmail.com>"
  ],
  "bugs": {
    "url": "https://github.com/bluehive-health/zipcodes/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehive-health/zipcodes.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./states": {
      "types": "./dist/states.d.ts",
      "default": "./dist/states.js"
    },
    "./lib": "./dist/index.js",
    "./lib/index": "./dist/index.js",
    "./lib/index.js": "./dist/index.js",
    "./lib/codes": "./dist/codes.js",
    "./lib/codes.js": "./dist/codes.js",
    "./lib/states": "./dist/states.js",
    "./lib/states.js": "./dist/states.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "llms.txt"
  ],
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "build": "npm run generate && tsc -p tsconfig.json && node scripts/write-esm-wrapper.mjs",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "bench": "npm run build && node scripts/bench.mjs",
    "data:update": "./scripts/fetch.sh",
    "prepack": "npm run build",
    "website:dev": "npm run build && npm --prefix website run dev",
    "website:build": "npm run build && npm --prefix website ci && npm --prefix website run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
